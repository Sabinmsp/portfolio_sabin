# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# Web3Forms — public access key (embedded in client bundle). Browser submits directly to api.web3forms.com.
# Create a key at https://web3forms.com — restrict to your domain in the dashboard when possible.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: absolute site URL for canonical + Open Graph tags.
# On Vercel this is inferred automatically; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=
